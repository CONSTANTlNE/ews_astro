---
import Icon from './Icon.astro';
import { l, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
const { lang, slug, data, delay = 0 } = Astro.props as { lang: Lang; slug: string; data: any; delay?: number };
const t = useTranslations(lang);
---
<a class="card service-card" href={l(lang, `/services/${slug}/`)} data-reveal style={`--d:${delay}ms`}>
  <span class="ico"><Icon name={data.icon} /></span>
  <h3>{data.title}</h3>
  <p>{data.description}</p>
  <span class="more">{t('cta.readmore')} <Icon name="arrow" size={18} /></span>
</a>
