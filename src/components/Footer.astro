---
import { useTranslations, l } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE } from '../config';
const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="logo" href={l(lang, '/')}><img src="/favicon.svg" alt="" width="32" height="32" />{SITE.name}</a>
        <p style="color:var(--muted);margin-top:1rem;max-width:36ch">{t('footer.tagline')}</p>
      </div>
      <div>
        <h4>{t('footer.explore')}</h4>
        <ul>
          <li><a href={l(lang, '/services/')}>{t('nav.services')}</a></li>
          <li><a href={l(lang, '/projects/')}>{t('nav.projects')}</a></li>
          <li><a href={l(lang, '/blog/')}>{t('nav.blog')}</a></li>
          <li><a href={l(lang, '/contact/')}>{t('nav.contact')}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t('footer.follow')}</h4>
        <ul>
          <li><a href={SITE.github} rel="me noopener" target="_blank">GitHub</a></li>
          <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a href={l(lang, '/rss.xml')}>RSS</a></li>
        </ul>
      </div>
    </div>
    <div class="copy"><span>© {new Date().getFullYear()} {SITE.name}. {t('footer.rights')}</span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
  </div>
</footer>
