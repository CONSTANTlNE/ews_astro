---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { htmlLang, ogLocale, type Lang } from '../i18n/ui';
import { useTranslations, switchPath } from '../i18n/utils';
import { imgUrl } from '../lib/img';

interface Props {
  title: string;
  description: string;
  image?: string; // unsplash id or path
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: object[];
  noindex?: boolean;
  noAlternates?: boolean;
}
const { title, description, image, type = 'website', publishedTime, modifiedTime, jsonLd = [], noindex = false, noAlternates = false } = Astro.props;
const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const site = Astro.site!;
const path = Astro.url.pathname;
const canonical = new URL(path, site).href;
const other: Lang = lang === 'en' ? 'ka' : 'en';
const alt = (lg: Lang) => new URL(switchPath(path, lg), site).href;
const ogImage = image ? (image.startsWith('http') ? imgUrl(image) : image.startsWith('photo-') ? imgUrl(image, 1200, 630) : new URL(image, site).href) : SITE.ogImage;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site.origin}/#org`, name: SITE.name, url: site.origin, logo: new URL('/favicon.svg', site).href, email: SITE.email, telephone: SITE.phone, sameAs: [SITE.github, SITE.linkedin].filter(Boolean) },
    { '@type': 'WebSite', '@id': `${site.origin}/#website`, url: site.origin, name: SITE.name, inLanguage: ['en', 'ka'], publisher: { '@id': `${site.origin}/#org` } },
  ],
};
---
<!doctype html>
<html lang={htmlLang[lang]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="canonical" href={canonical} />
    {!noAlternates && <>
      <link rel="alternate" hreflang={lang} href={canonical} />
      <link rel="alternate" hreflang={other} href={alt(other)} />
      <link rel="alternate" hreflang="x-default" href={alt('en')} />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} – Blog`} href={new URL(`/${lang}/rss.xml`, site).href} />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {[orgLd, ...jsonLd].map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    <!-- Theme: set before first paint to avoid flash -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var s; try { s = localStorage.getItem('theme'); } catch (e) {}
        d.dataset.theme = s || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
      const burger = document.getElementById('burger');
      const nav = document.getElementById('nav');
      burger?.addEventListener('click', () => {
        const open = nav!.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(open));
      });
      const header = document.getElementById('header');
      const onScroll = () => header?.classList.toggle('scrolled', scrollY > 8);
      onScroll(); addEventListener('scroll', onScroll, { passive: true });

      // Scroll-reveal
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));

      // Count-up numbers
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const target = Number(el.dataset.count); const suffix = el.dataset.suffix ?? '';
        const io = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return; io.disconnect();
          const t0 = performance.now();
          const tick = (now: number) => {
            const p = Math.min(1, (now - t0) / 1400);
            el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
        io.observe(el);
      });
    </script>
  </body>
</html>
