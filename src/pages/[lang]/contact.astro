---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, l } from '../../i18n/utils';
import { languages, type Lang } from '../../i18n/ui';
import { SITE } from '../../config';
export function getStaticPaths() { return Object.keys(languages).map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const crumbs = [{ name: t('nav.home'), href: l(lang, '/') }, { name: t('nav.contact') }];
const ld = [{ '@context': 'https://schema.org', '@type': 'ContactPage', name: t('contact.title'), url: Astro.url.href, mainEntity: { '@id': `${Astro.site!.origin}/#org` } }];
---
<Base title={t('contact.title')} description={t('seo.contact.desc')} jsonLd={ld}>
  <section class="page-head"><div class="container hero-in">
    <Breadcrumbs items={crumbs} /><h1>{t('contact.title')}</h1><p class="lead">{t('contact.lead')}</p>
  </div></section>
  <section class="section" style="padding-top:1rem"><div class="container">
    <dl class="contact-grid" style="margin:0">
      <div class="contact-item" data-reveal><dt>{t('contact.email')}</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
      <div class="contact-item" data-reveal style="--d:100ms"><dt>{t('contact.phone')}</dt><dd><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></dd></div>
      <div class="contact-item" data-reveal style="--d:200ms"><dt>{t('contact.address')}</dt><dd>{t('contact.addressValue')}</dd><p style="color:var(--muted);margin:.4rem 0 0;font-size:.95rem">{t('contact.hours')}</p></div>
    </dl>
    <p style="margin-top:2rem" data-reveal><a class="btn btn-primary" href={`mailto:${SITE.email}`}>{t('cta.start')} <Icon name="arrow" size={18} /></a></p>
  </div></section>
</Base>
