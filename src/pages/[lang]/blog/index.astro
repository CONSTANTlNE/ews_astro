---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getPosts } from '../../../lib/content';
import { useTranslations, l } from '../../../i18n/utils';
import { languages, type Lang } from '../../../i18n/ui';
export function getStaticPaths() { return Object.keys(languages).map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const crumbs = [{ name: t('nav.home'), href: l(lang, '/') }, { name: t('nav.blog') }];
const site = Astro.site!;
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, ...(c.href ? { item: new URL(c.href, site).href } : {}) })) },
  { '@context': 'https://schema.org', '@type': 'Blog', name: t('blog.title'), url: Astro.url.href, inLanguage: lang },
];
---
<Base title={t('blog.title')} description={t('seo.blog.desc')} jsonLd={ld}>
  <section class="page-head"><div class="container hero-in">
    <Breadcrumbs items={crumbs} /><h1>{t('blog.title')}</h1><p class="lead">{t('blog.lead')}</p>
  </div></section>
  <section class="section" style="padding-top:1rem"><div class="container">
    {posts.length === 0 ? <p>{t('blog.empty')}</p> : <div class="grid cols-3">{posts.map((p, i) => <PostCard lang={lang} slug={p.slug} data={p.data} delay={(i % 3) * 100} />)}</div>}
  </div></section>
</Base>
